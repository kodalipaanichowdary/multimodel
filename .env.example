# Copy to .env to override. Read by scripts/*.mjs and the API. No secrets belong here.
API_PORT=8000
UI_PORT=5173

# Executor: real runtime by default. MOCK_EXECUTOR=1 = scripted P1 executor (tests only).
MOCK_EXECUTOR=0
MOCK_STEP_DELAY_S=0.6

# Model gateway: ollama (default) | stub (tests only)
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096

# Tools: SEARCH_PROVIDER=auto|ddg|wikipedia (stub|empty = tests), FETCH_PROVIDER=live (stub = tests)
SEARCH_PROVIDER=auto
FETCH_PROVIDER=live

# Approvals for fs.write / terminal.exec: seconds before an unanswered request is denied
APPROVAL_TIMEOUT_S=120

# Event log (SQLite). "none" disables persistence.
# POS_DB_PATH=apps/api/data/pos.db
